# Self-hosted HTTPS origin. Do not commit .env or real secrets.
APP_DOMAIN=orders.example.ru
ALLOWED_ORIGINS=https://orders.example.ru
COOKIE_SECURE=true
DEMO_MODE=false
# Optional: PostgreSQL. Empty => SQLite on the named Docker volume.
DATABASE_URL=
# Required with PostgreSQL: generate e.g. python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=
